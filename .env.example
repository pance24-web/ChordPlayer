# Salin file ini menjadi .env, lalu isi dengan kredensial database kamu.
# JANGAN commit file .env yang asli — hanya file .env.example ini yang boleh masuk Git.

DB_HOST=your-db-host
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=your-db-name

# Set 'true' jika database menggunakan SSL (wajib untuk provider cloud seperti Aiven)
DB_SSL=false